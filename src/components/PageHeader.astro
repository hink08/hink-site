---
// Consistent top-of-page block: eyebrow label, title, intro, optional extras.
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-header">
	{eyebrow && <p class="label">{eyebrow}</p>}
	<h1>{title}</h1>
	{description && <p class="description">{description}</p>}
	<slot />
</header>
<style>
	.page-header {
		padding-bottom: 2rem;
		margin-bottom: 2.5rem;
		border-bottom: 1px solid var(--border);
	}
	h1 {
		margin-top: 0.35rem;
		margin-bottom: 0.5rem;
	}
	.description {
		max-width: var(--measure);
		margin: 0;
		font-size: 1.15rem;
		color: var(--text-muted);
	}
</style>
