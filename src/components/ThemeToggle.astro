---
// Light/dark toggle. The initial theme is set by the inline script in BaseHead
// (saved choice, else OS preference). Picking the theme that matches the OS
// clears the saved choice, so the site goes back to following the system.
---

<button type="button" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
	<svg class="icon-moon" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
		<path
			fill="currentColor"
			d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278"
		></path>
	</svg>
	<svg class="icon-sun" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
		<path
			fill="currentColor"
			d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"
		></path>
	</svg>
</button>

<script>
	const root = document.documentElement;
	const media = matchMedia('(prefers-color-scheme: dark)');
	const systemTheme = () => (media.matches ? 'dark' : 'light');

	function save(theme: string | null) {
		try {
			if (theme) localStorage.setItem('theme', theme);
			else localStorage.removeItem('theme');
		} catch {}
	}
	function saved() {
		try {
			return localStorage.getItem('theme');
		} catch {
			return null;
		}
	}
	function sync() {
		const isDark = root.dataset.theme === 'dark';
		for (const btn of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
			const label = isDark ? 'Switch to light mode' : 'Switch to dark mode';
			btn.setAttribute('aria-label', label);
			btn.title = label;
		}
	}

	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

	function apply(next: string) {
		root.dataset.theme = next;
		save(next === systemTheme() ? null : next);
		sync();
	}

	for (const btn of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
		btn.addEventListener('click', () => {
			const next = root.dataset.theme === 'dark' ? 'light' : 'dark';

			if (!document.startViewTransition || reducedMotion.matches) {
				apply(next);
				return;
			}

			// Circular reveal of the new theme, expanding from the button.
			const { left, top, width, height } = btn.getBoundingClientRect();
			const x = left + width / 2;
			const y = top + height / 2;
			const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

			root.classList.add('theme-transition');
			const transition = document.startViewTransition(() => apply(next));
			transition.ready.then(() => {
				root.animate(
					{ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
					{ duration: 500, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', pseudoElement: '::view-transition-new(root)' },
				);
			});
			transition.finished.finally(() => root.classList.remove('theme-transition'));
		});
	}

	// Follow OS changes live unless the visitor has made an explicit choice.
	media.addEventListener('change', () => {
		if (!saved()) {
			root.dataset.theme = systemTheme();
			sync();
		}
	});

	sync();
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--text);
		background: var(--surface);
	}
	@media (prefers-reduced-motion: no-preference) {
		.theme-toggle {
			transition:
				color 0.2s,
				background-color 0.2s;
		}
		.theme-toggle svg {
			transition: transform 0.5s var(--ease-out);
		}
		.theme-toggle:hover svg {
			transform: rotate(25deg);
		}
		.theme-toggle:active svg {
			transform: rotate(25deg) scale(0.85);
		}
	}
	.theme-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	/* Show the icon for the theme you'd switch *to*. */
	.icon-sun {
		display: none;
	}
	:global([data-theme='dark']) .icon-sun {
		display: block;
	}
	:global([data-theme='dark']) .icon-moon {
		display: none;
	}
</style>
