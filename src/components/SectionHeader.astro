---
// Section title with an optional "view all" style link on the right.
// Titles are auto-numbered per page ("FIG. 01 — …") like figures on a drawing.
interface Props {
	title: string;
	href?: string;
	linkLabel?: string;
	id?: string;
	/** Set false to skip the FIG. number. */
	numbered?: boolean;
}

const { title, href, linkLabel = 'View all', id, numbered = true } = Astro.props;
---

<div class="section-header">
	<h2 class:list={['label', { numbered }]} id={id}>{title}<slot /></h2>
	{href && <a href={href}>{linkLabel} →</a>}
</div>
<style>
	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.6rem;
		margin-bottom: 0.5rem;
		border-bottom: 1px solid var(--border);
	}
	.numbered::before {
		counter-increment: fig;
		content: 'Fig. ' counter(fig, decimal-leading-zero) ' — ';
		color: var(--accent);
	}
	a {
		font-size: 0.9rem;
		text-decoration: none;
		white-space: nowrap;
	}
	a:hover {
		text-decoration: underline;
	}
</style>
