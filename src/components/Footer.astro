---
import { NAV_LINKS, SITE, SOCIAL_LINKS } from '../site.config';
---

<footer class="site-footer">
	<div class="container">
		<div class="columns">
			<div class="about">
				<p class="name">{SITE.title}</p>
				<p class="muted">{SITE.description}</p>
			</div>
			<nav aria-label="Footer">
				<p class="label">Site</p>
				<ul>{NAV_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
			</nav>
			<div>
				<p class="label">Elsewhere</p>
				<ul>
					{
						SOCIAL_LINKS.map((l) => (
							<li>
								<a href={l.href}>{l.label}</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<p class="copyright">&copy; {new Date().getFullYear()} {SITE.author}</p>
	</div>
</footer>
<style>
	.site-footer {
		margin-top: 5rem;
		border-top: 1px solid var(--border);
		background: var(--surface);
		font-size: 0.95rem;
	}
	.columns {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 2rem;
		padding-block: 3rem 2rem;
	}
	p {
		margin: 0;
	}
	.name {
		font-weight: 700;
	}
	.muted {
		color: var(--text-muted);
		margin-top: 0.25rem;
		max-width: 22rem;
	}
	ul {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
	}
	li + li {
		margin-top: 0.35rem;
	}
	ul a {
		color: var(--text);
		text-decoration: none;
	}
	ul a:hover {
		color: var(--accent);
	}
	.copyright {
		padding-block: 1.25rem;
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.85rem;
	}
	@media (max-width: 640px) {
		.columns {
			grid-template-columns: 1fr 1fr;
		}
		.about {
			grid-column: 1 / -1;
		}
	}
</style>
