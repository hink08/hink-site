---
import { NAV_LINKS, PROFILE, SITE, SOCIAL_LINKS } from '../site.config';

// Drafting "title block" values. Rev is the build date.
const now = new Date();
const rev = [now.getUTCFullYear(), now.getUTCMonth() + 1, now.getUTCDate()].map((n) => String(n).padStart(2, '0')).join('.');
const titleBlock = [
	{ label: 'Drawn by', value: SITE.author },
	{ label: 'Location', value: PROFILE.location },
	{ label: 'Project', value: new URL(SITE.url).host },
	{ label: 'Rev', value: rev },
	{ label: 'Sheet', value: '1 of 1' },
];
---

<footer class="site-footer">
	<div class="container">
		<div class="columns">
			<div class="about">
				<p class="name">{SITE.title}</p>
				<p class="muted">{SITE.description}</p>
			</div>
			<nav aria-label="Footer">
				<p class="label">Site</p>
				<ul>{NAV_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
			</nav>
			<div>
				<p class="label">Elsewhere</p>
				<ul>
					{
						SOCIAL_LINKS.map((l) => (
							<li>
								<a href={l.href}>{l.label}</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<dl class="title-block">
			{
				titleBlock.map((cell) => (
					<div>
						<dt class="label">{cell.label}</dt>
						<dd>{cell.value}</dd>
					</div>
				))
			}
		</dl>
		<p class="copyright">&copy; {now.getFullYear()} {SITE.author}</p>
	</div>
</footer>
<style>
	.site-footer {
		margin-top: 5rem;
		border-top: 1px solid var(--border);
		background: var(--surface);
		font-size: 0.95rem;
	}
	.columns {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 2rem;
		padding-block: 3rem 2rem;
	}
	p {
		margin: 0;
	}
	.name {
		font-weight: 700;
	}
	.muted {
		color: var(--text-muted);
		margin-top: 0.25rem;
		max-width: 22rem;
	}
	ul {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
	}
	li + li {
		margin-top: 0.35rem;
	}
	ul a {
		color: var(--text);
		text-decoration: none;
	}
	ul a:hover {
		color: var(--accent);
	}

	/* Title block: bordered cells like the corner of an engineering drawing. */
	.title-block {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 1px;
		margin: 0;
		background: var(--mark);
		border: 1px solid var(--mark);
	}
	.title-block div {
		padding: 0.5rem 0.75rem;
		background: var(--surface);
	}
	.title-block dt {
		font-size: 0.62rem;
	}
	.title-block dd {
		margin: 0.1rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.82rem;
	}
	.copyright {
		padding-block: 1.25rem;
		color: var(--text-muted);
		font-size: 0.85rem;
	}
	@media (max-width: 640px) {
		.columns {
			grid-template-columns: 1fr 1fr;
		}
		.about {
			grid-column: 1 / -1;
		}
	}
</style>
