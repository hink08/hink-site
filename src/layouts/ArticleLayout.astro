---
// Shared shell for single entries (blog posts, notes, book notes):
// a sticky metadata sidebar on the left and a readable text column on the right.
import type { ComponentProps } from 'astro/types';
import BaseLayout from './BaseLayout.astro';

type Props = ComponentProps<typeof BaseLayout> & {
	/** Small label above the title, e.g. "Blog" or "Note". */
	eyebrow: string;
	/** Heading shown in the article (defaults to `title`). */
	heading?: string;
	subtitle?: string;
	back: { href: string; label: string };
};

const { eyebrow, heading, subtitle, back, ...base } = Astro.props;
---

<BaseLayout {...base}>
	<article class="with-sidebar sidebar-left">
		<aside>
			<div class="sidebar">
				<a class="back" href={back.href}>← {back.label}</a>
				<slot name="meta" />
			</div>
		</aside>
		<div class="body">
			<header>
				<p class="label">{eyebrow}</p>
				<h1>{heading ?? base.title}</h1>
				{subtitle && <p class="subtitle">{subtitle}</p>}
			</header>
			<slot name="before" />
			<div class="prose measure">
				<slot />
			</div>
		</div>
	</article>
</BaseLayout>
<style>
	.sidebar {
		position: sticky;
		top: 6rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.back {
		text-decoration: none;
	}
	.back:hover {
		text-decoration: underline;
	}
	.sidebar :global(dl) {
		margin: 0;
		display: grid;
		gap: 0.9rem;
	}
	.sidebar :global(dt) {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}
	.sidebar :global(dd) {
		margin: 0.1rem 0 0;
		color: var(--text);
	}
	header {
		max-width: var(--measure);
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}
	h1 {
		margin: 0.35rem 0 0;
	}
	.subtitle {
		margin: 0.5rem 0 0;
		font-size: 1.15rem;
		color: var(--text-muted);
	}
	@media (max-width: 860px) {
		.sidebar {
			position: static;
		}
		aside {
			order: 2;
			padding-top: 1.5rem;
			border-top: 1px solid var(--border);
		}
	}
</style>
