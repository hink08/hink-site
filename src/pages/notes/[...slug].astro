---
import { render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getNotes, type Note } from '../../lib/notes';

export async function getStaticPaths() {
	const notes = await getNotes();
	return notes.map((note) => ({ params: { slug: note.id }, props: note }));
}

type Props = Note;

const note = Astro.props;
const { title, pubDate, tags } = note.data;
const { Content } = await render(note);
const description = note.body?.trim().replace(/\s+/g, ' ').slice(0, 155);
---

<ArticleLayout title={title} description={description} type="article" eyebrow="Note" back={{ href: '/notes', label: 'All notes' }}>
	<dl slot="meta">
		<div>
			<dt>Posted</dt>
			<dd><FormattedDate date={pubDate} /></dd>
		</div>
		{
			tags.length > 0 && (
				<div>
					<dt>Tags</dt>
					<dd>
						<ul class="tags">
							{tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					</dd>
				</div>
			)
		}
	</dl>
	<Content />
</ArticleLayout>
<style>
	.tags {
		margin-top: 0.3rem;
	}
</style>
