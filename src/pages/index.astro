---
import BookList from '../components/BookList.astro';
import NoteList from '../components/NoteList.astro';
import PostList from '../components/PostList.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBooks } from '../lib/books';
import { getNotes } from '../lib/notes';
import { getPosts } from '../lib/posts';
import { PROFILE } from '../site.config';

const posts = await getPosts();
const notes = await getNotes();
const books = await getBooks();
const reading = books.filter((b) => b.data.status === 'reading');

const sections = [
	{ href: '/blog', title: 'Blog', text: 'Longer writing on projects and ideas.', count: posts.length, unit: 'post' },
	{ href: '/notes', title: 'Notes', text: 'Short thoughts and things I’ve learned.', count: notes.length, unit: 'note' },
	{ href: '/books', title: 'Books', text: 'What I’m reading and what I thought.', count: books.length, unit: 'book' },
	{ href: '/now', title: 'Now', text: 'What I’m focused on at the moment.' },
];
---

<BaseLayout>
	<div class="stack">
		<section class="hero">
			<div class="intro">
				<p class="label">{PROFILE.roleShort} · Systems architect · {PROFILE.location}</p>
				<h1>I'm Ryan Hinkle.</h1>
				<p class="lede">
					I'm a CTO who still spends most of his time in the technical design: system architecture,
					platform decisions, and how the pieces fit together. This is where I write about what I'm
					building, learning, and reading.
				</p>
				<p class="actions">
					<a class="button primary" href="/blog">Read the blog</a>
					<a class="button" href="/about">About me</a>
				</p>
			</div>
			<SystemDiagram posts={posts.length} notes={notes.length} reading={reading.length} />
		</section>

		<div class="with-sidebar">
			<section>
				<SectionHeader title="Recent writing" href="/blog" />
				<PostList posts={posts.slice(0, 5)} />
			</section>
			<div class="side">
				<section>
					<SectionHeader title="Currently reading" href="/books" linkLabel="Shelf" />
					{reading.length > 0 ? <BookList books={reading} compact /> : <p class="empty">Between books.</p>}
				</section>
				<section>
					<SectionHeader title="Latest notes" href="/notes" linkLabel="All" />
					<NoteList notes={notes.slice(0, 4)} full={false} />
				</section>
			</div>
		</div>

		<section>
			<SectionHeader title="Explore" />
			<ul class="sections">
				{
					sections.map((s) => (
						<li class="reveal">
							<a class="card lift" href={s.href}>
								<span class="name">{s.title}</span>
								<span class="text">{s.text}</span>
								{s.count !== undefined && (
									<span class="label">
										{s.count} {s.unit}
										{s.count === 1 ? '' : 's'}
									</span>
								)}
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</BaseLayout>
<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
		gap: var(--gap);
		align-items: center;
		padding-block: 0.5rem 3rem;
		border-bottom: 1px solid var(--border);
	}
	h1 {
		margin-block: 0.5rem 1rem;
		font-size: clamp(2.4rem, 5vw, 3.25rem);
	}
	.lede {
		font-size: 1.25rem;
		color: var(--text-muted);
		max-width: 32rem;
		margin: 0;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	@media (max-width: 860px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
		}
		.hero :global(.diagram) {
			justify-self: center;
		}
	}

	.side > * + * {
		margin-top: 2.5rem;
	}

	/* Explore: cards hang off a shared bus line, like modules on a system diagram. */
	.sections {
		position: relative;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		list-style: none;
		margin: 1rem 0 0;
		padding: 1.75rem 0 0;
	}
	.sections::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		left: 12.5%;
		right: 12.5%;
		height: 1px;
		background: var(--wire);
	}
	.sections li {
		position: relative;
	}
	.sections li::before,
	.sections li::after {
		content: '';
		position: absolute;
		left: 50%;
		pointer-events: none;
	}
	/* Vertical stub from the bus down to the card. */
	.sections li::before {
		top: -1.25rem;
		height: 1.25rem;
		width: 1px;
		background: var(--wire);
	}
	/* Junction dot on the bus. */
	.sections li::after {
		top: -1.25rem;
		width: 5px;
		height: 5px;
		margin: -2px 0 0 -2px;
		border-radius: 50%;
		background: var(--accent);
	}
	@media (max-width: 860px) {
		.sections {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			padding-top: 0;
		}
		.sections::before,
		.sections li::before,
		.sections li::after {
			display: none;
		}
	}
	@media (max-width: 480px) {
		.sections {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.sections a {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}
	.sections a:hover {
		border-color: var(--accent);
	}
	.sections a:hover .name {
		color: var(--accent);
	}
	.name {
		font-weight: 700;
		font-size: 1.1rem;
	}
	.text {
		color: var(--text-muted);
		font-size: 0.92rem;
		flex: 1;
	}
	.sections .label {
		margin-top: 0.5rem;
	}
</style>
