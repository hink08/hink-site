---
import { Image } from 'astro:assets';
import avatar from '../assets/ryan-hinkle.jpg';
import PageHeader from '../components/PageHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIAL_LINKS } from '../site.config';

const github = SOCIAL_LINKS.find((l) => l.name === 'github');
const linkedin = SOCIAL_LINKS.find((l) => l.name === 'linkedin');
---

<BaseLayout title="About" description="About Ryan Hinkle.">
	<PageHeader eyebrow="About" title="Hi, I'm Ryan." description="A bit about me and this site." />

	<div class="with-sidebar">
		<div class="prose measure">
			<!-- TODO: replace with a real bio. -->
			<p>
				I'm Ryan Hinkle. This site is my corner of the internet for writing about projects, things I'm
				learning, books I'm reading, and whatever else I find interesting.
			</p>
			<p>
				You can connect with me on {linkedin && <a href={linkedin.href}>LinkedIn</a>}, find my code on
				{github && <a href={github.href}>GitHub</a>}, or follow along via the
				<a href="/rss.xml">RSS feed</a>.
			</p>
		</div>

		<aside class="card profile">
			<Image class="photo" src={avatar} alt={`Photo of ${SITE.author}`} width={240} height={240} />
			<p class="name">{SITE.author}</p>
			<SocialLinks />
			<hr />
			<p class="label">Around the site</p>
			<ul>
				<li><a href="/blog">Blog</a> — longer writing</li>
				<li><a href="/notes">Notes</a> — short thoughts</li>
				<li><a href="/books">Books</a> — my bookshelf</li>
				<li><a href="/now">Now</a> — current focus</li>
			</ul>
		</aside>
	</div>
</BaseLayout>
<style>
	.photo {
		display: block;
		width: 7.5rem;
		height: 7.5rem;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid var(--bg);
		box-shadow: 0 0 0 1px var(--border);
	}
	@media (prefers-reduced-motion: no-preference) {
		.photo {
			transition: transform 0.4s var(--ease-out);
		}
		.photo:hover {
			transform: rotate(-4deg) scale(1.05);
		}
	}
	.name {
		margin: 0.75rem 0 0.5rem;
		font-weight: 700;
		font-size: 1.1rem;
	}
	hr {
		margin-block: 1.25rem;
	}
	aside ul {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
		font-size: 0.95rem;
		color: var(--text-muted);
	}
	aside li + li {
		margin-top: 0.4rem;
	}
</style>
