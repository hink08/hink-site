---
import { Image } from 'astro:assets';
import avatar from '../assets/ryan-hinkle.jpg';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE, SITE, SOCIAL_LINKS } from '../site.config';

const github = SOCIAL_LINKS.find((l) => l.name === 'github');
const linkedin = SOCIAL_LINKS.find((l) => l.name === 'linkedin');

const specs = [
	{ label: 'Role', value: PROFILE.role },
	{ label: 'Focus', value: PROFILE.focus },
	{ label: 'Based in', value: PROFILE.location },
	{ label: 'Company', value: PROFILE.employer.name },
	{ label: 'Education', value: PROFILE.schoolFull },
	{ label: 'Interests', value: PROFILE.interests.join(' · ') },
];
---

<BaseLayout title="About" description="About Ryan Hinkle.">
	<PageHeader eyebrow="About" title="Hi, I'm Ryan." description="A bit about me and this site." />

	<div class="with-sidebar">
		<div class="prose measure">
			<!-- TODO: replace with a real bio. -->
			<p>
				I'm Ryan Hinkle, Chief Technology Officer at {PROFILE.employer.name}, based in {PROFILE.location}.
				The title says leadership, but a lot of my week is still technical design work: system
				architecture, platform and infrastructure decisions, and digging into how the pieces fit together.
			</p>
			<p>
				This site is where I write about that work, the things I'm learning, the books I'm reading, and
				whatever else I find interesting.
			</p>
			<p>
				You can connect with me on {linkedin && <a href={linkedin.href}>LinkedIn</a>}, find my code on{' '}
				{github && <a href={github.href}>GitHub</a>}, or follow along via the{' '}
				<a href="/rss.xml">RSS feed</a>.
			</p>

			<section class="specs">
				<SectionHeader title="Specifications" />
				<dl>
					{
						specs.map((s) => (
							<div>
								<dt class="label">{s.label}</dt>
								<dd>{s.value}</dd>
							</div>
						))
					}
				</dl>
			</section>
		</div>

		<aside class="card profile">
			<Image class="photo" src={avatar} alt={`Photo of ${SITE.author}`} width={240} height={240} />
			<p class="name">{SITE.author}</p>
			<SocialLinks />
			<hr />
			<p class="label">Around the site</p>
			<ul>
				<li><a href="/blog">Blog</a> — longer writing</li>
				<li><a href="/notes">Notes</a> — short thoughts</li>
				<li><a href="/books">Books</a> — my bookshelf</li>
				<li><a href="/now">Now</a> — current focus</li>
			</ul>
		</aside>
	</div>
</BaseLayout>
<style>
	.specs {
		margin-top: 3rem;
	}
	.specs dl {
		margin: 0;
	}
	.specs dl div {
		display: grid;
		grid-template-columns: 8rem minmax(0, 1fr);
		gap: 1rem;
		padding-block: 0.7rem;
		border-bottom: 1px dashed var(--border);
	}
	.specs dt {
		padding-top: 0.2rem;
	}
	.specs dd {
		margin: 0;
	}
	@media (max-width: 480px) {
		.specs dl div {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.1rem;
		}
	}
	.photo {
		display: block;
		width: 7.5rem;
		height: 7.5rem;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid var(--bg);
		box-shadow: 0 0 0 1px var(--border);
	}
	@media (prefers-reduced-motion: no-preference) {
		.photo {
			transition: transform 0.4s var(--ease-out);
		}
		.photo:hover {
			transform: rotate(-4deg) scale(1.05);
		}
	}
	.name {
		margin: 0.75rem 0 0.5rem;
		font-weight: 700;
		font-size: 1.1rem;
	}
	hr {
		margin-block: 1.25rem;
	}
	aside ul {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
		font-size: 0.95rem;
		color: var(--text-muted);
	}
	aside li + li {
		margin-top: 0.4rem;
	}
</style>
